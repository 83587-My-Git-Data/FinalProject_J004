package com.childadoption.security;


import java.util.List;

import javax.sql.DataSource;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.config.annotation.method.configuration.EnableMethodSecurity;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
import org.springframework.security.core.authority.SimpleGrantedAuthority;
import org.springframework.security.core.userdetails.User;
import org.springframework.security.core.userdetails.UserDetailsService;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.security.provisioning.InMemoryUserDetailsManager;
import org.springframework.security.provisioning.JdbcUserDetailsManager;
import org.springframework.security.web.SecurityFilterChain;


@Configuration
@EnableWebSecurity
@EnableMethodSecurity
public class SecurityConfig {
	
	@Autowired
	DataSource datasource ;
		
	@Autowired
	private PasswordEncoder encoder;
	
	@Bean
	public UserDetailsService users() {
		User admin = new User("Abhay", encoder.encode("Abhay@123"), List.of(new SimpleGrantedAuthority("ROLE_ADMIN")));
		User user = new User("Ranjit", encoder.encode("Ranjit@123"), List.of(new SimpleGrantedAuthority("ROLE_USER")));
		User ngoAdmin = new User("Ninad", encoder.encode("Ninad@123"), List.of(new SimpleGrantedAuthority("ROLE_NGOADMIN")));
		JdbcUserDetailsManager userDetailsManager = new JdbcUserDetailsManager(null);
		return new InMemoryUserDetailsManager(user, admin, ngoAdmin);
	}
	
	@Bean
	public SecurityFilterChain authorizeRequest(HttpSecurity http) throws Exception{
		http.csrf().disable().authorizeRequests()
		.antMatchers("/orphan/add","/orphan/edit", "/orphan/*", "/v*/api-doc*/**","/swagger-ui/**" ).hasRole("NGOADMIN")
		.anyRequest().authenticated().and().httpBasic();
		return http.build();
	}
}
