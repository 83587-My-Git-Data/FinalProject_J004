package com.childadoption.security;


import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.core.authority.SimpleGrantedAuthority;
import org.springframework.security.core.userdetails.User;
import org.springframework.security.core.userdetails.UserDetailsService;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.security.provisioning.InMemoryUserDetailsManager;
import org.springframework.security.web.SecurityFilterChain;


@Configuration
public class SecurityConfig {
	
	@Autowired
	private PasswordEncoder passwordEncoder;
	
	@Bean
	public UserDetailsService users() {
		User admin = new User("Abhay", passwordEncoder.encode("Abhay@123"), List.of(new SimpleGrantedAuthority("ROLE_ADMIN")));
		User user = new User("Ranjit", passwordEncoder.encode("Ranjit@123"), List.of(new SimpleGrantedAuthority("ROLE_USER")));
		return new InMemoryUserDetailsManager(user, admin);
	}
	
	@Bean
	public SecurityFilterChain authorizeRequest(HttpSecurity http) throws Exception{
		http.csrf().disable().authorizeRequests().antMatchers("").permitAll().antMatchers("").hasRole("ADMIN")
		.antMatchers("/orphan/add","/orphan/edit" ).hasRole("NGOADMIN").antMatchers("").hasRole("USER")
		.anyRequest().authenticated().and().httpBasic();
		return http.build();
	}
}
