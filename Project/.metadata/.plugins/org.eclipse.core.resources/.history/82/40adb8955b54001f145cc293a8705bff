package com.childadoption.entities;
import javax.persistence.*;

import lombok.*;

@NoArgsConstructor
@Getter
@Setter
@ToString
@Entity
@Table(name="states")
public class State {
	
	@Column(name="state_code",nullable=false)
	private String stateCode;
	@Column(name="state_name",nullable= false)
	private String stateName;
}
